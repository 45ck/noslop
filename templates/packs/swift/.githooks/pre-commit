#!/bin/sh
# noslop pre-commit: fast gates (format, lint, spell)
set -e

# Block commits that modify protected quality gate config or hook files.
# Humans can use NOSLOP_ALLOW_PROTECTED_CHANGES=1 for local maintenance; CI still requires noslop-approved.
PROTECTED_CONFIGS=".swiftlint.yml"

protected_change() {
  path="$1"
  kind="$2"
  if [ "${NOSLOP_ALLOW_PROTECTED_CHANGES:-}" = "1" ]; then
    echo "noslop: allowing protected ${kind} change to ${path}; CI still requires noslop-approved." >&2
    return 0
  fi
  echo "noslop: ${path} is protected ${kind} -- changes require explicit maintenance approval." >&2
  echo "  For local maintenance only, rerun with NOSLOP_ALLOW_PROTECTED_CHANGES=1." >&2
  echo "  PRs must still carry the noslop-approved label." >&2
  exit 1
}

while IFS= read -r staged_file; do
  for cfg in $PROTECTED_CONFIGS; do
    if [ "$staged_file" = "$cfg" ]; then
      protected_change "$cfg" "quality gate config"
    fi
  done
  case "$staged_file" in
    .githooks/*|.github/workflows/*|.claude/hooks/*|.claude/settings.json|AGENTS.md)
      protected_change "$staged_file" "gate infrastructure"
      ;;
  esac
done << STAGED
$(git diff --cached --name-only 2>/dev/null)
STAGED

swift-format lint --recursive . && swiftlint lint && typos
